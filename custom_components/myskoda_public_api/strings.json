      "message": "The API rate limit for this vehicle is exhausted. Try again in {retry_after} seconds."
    },
    "operation_rejected": {
      "message": "The vehicle rejected the command: {detail}"
    },
    "command_failed": {
      "message": "The command failed: {detail}"
    },
