  "services": {
    "start_air_conditioning": {
      "name": "Start air conditioning",
      "description": "Starts the air conditioning of the vehicle, optionally with a target temperature.",
      "fields": {
        "device_id": {
          "name": "Vehicle",
          "description": "The vehicle to climatise."
        },
        "temperature": {
          "name": "Target temperature",
          "description": "Target cabin temperature in °C (16 to 30)."
        },
        "without_external_power": {
          "name": "Allow without external power",
          "description": "Allow the air conditioning to run while the vehicle is not plugged in."
        }
      }
    },
    "start_auxiliary_heating": {
      "name": "Start auxiliary heating",
      "description": "Starts the auxiliary heater (or its ventilation mode). Requires the S-PIN, either stored in the options or passed here.",
      "fields": {
        "device_id": {
          "name": "Vehicle",
          "description": "The vehicle to heat."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the heater runs, in minutes."
        },
        "start_mode": {
          "name": "Mode",
          "description": "Heating or ventilation."
        },
        "temperature": {
          "name": "Target temperature",
          "description": "Target cabin temperature in °C (16 to 30)."
        },
        "spin": {
          "name": "S-PIN",
          "description": "Security PIN of the MyŠkoda account. Overrides the S-PIN stored in the options."
        }
      }
