{
  "config": {
    "step": {
      "user": {
        "title": "Add a Škoda vehicle",
        "description": "Create an API key in the MyŠkoda app ({api_keys_url}), select the vehicle it may access and enter the key together with the VIN of that vehicle. The key is checked with a single API request.",
        "data": {
          "api_key": "API key",
          "vin": "VIN (vehicle identification number)"
        },
        "data_description": {
          "api_key": "Key created in the MyŠkoda app. Keys expire; the integration asks for a new one when needed.",
          "vin": "17 characters, as shown in the MyŠkoda app or in the registration document."
        }
      },
      "reauth_confirm": {
        "title": "Renew the API key",
        "description": "The API key for {name} has expired or is no longer valid. Create a new key in the MyŠkoda app ({api_keys_url}) and enter it here.",
        "data": {
          "api_key": "API key"
        }
      },
      "reconfigure": {
        "title": "Replace the API key",
        "description": "Enter a new API key for {name}. Create keys in the MyŠkoda app ({api_keys_url}).",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the MyŠkoda Public API.",
      "invalid_auth": "The API key was rejected, has expired or does not cover this vehicle.",
      "invalid_vin": "A VIN has 17 characters and contains no I, O or Q.",
      "vehicle_not_found": "No vehicle with this VIN was found for the API key.",
      "rate_limited": "The API rate limit for this vehicle is exhausted. Wait a while and try again.",
      "unknown": "Unexpected error, see the log for details."
    },
    "abort": {
      "already_configured": "This vehicle is already configured.",
      "reauth_successful": "The API key was updated.",
      "reconfigure_successful": "The API key was updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "MyŠkoda options",
        "description": "The API allows about 20 requests per hour and vehicle. Every poll, every remote command and the refresh after a command count against that quota. S-PIN: {spin_state}.",
        "data": {
          "scan_interval": "Polling interval",
          "spin": "S-PIN (for the auxiliary heater)",
          "remove_spin": "Remove the stored S-PIN"
        },
        "data_description": {
          "scan_interval": "Seconds between two polls. 300 s equals 12 requests per hour.",
          "spin": "Only needed to start the auxiliary heater. Leave empty to keep the stored S-PIN."
        }
      }
    }
  },
